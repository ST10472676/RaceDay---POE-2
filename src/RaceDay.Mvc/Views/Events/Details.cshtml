@model ApiPageViewModel
@{var e=Model.Data;var id=e.GetProperty("eventID").GetInt32();ViewData["Title"]=e.GetProperty("eventName").GetString();}
<a asp-controller="Home" asp-action="Index" class="text-decoration-none">← All events</a><div class="card panel mt-3 overflow-hidden">@if(e.TryGetProperty("bannerImageUrl",out var banner)&&!string.IsNullOrWhiteSpace(banner.GetString())){<img src="@banner.GetString()" style="max-height:340px;object-fit:cover"/>}<div class="card-body p-4"><span class="badge text-bg-primary">@e.GetProperty("eventType").GetString()</span><h1 class="section-title mt-2">@e.GetProperty("eventName").GetString()</h1><p class="lead">@e.GetProperty("description").GetString()</p><div class="row g-3 mb-4"><div class="col-md-3"><b>Date</b><br/>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMMM yyyy")</div><div class="col-md-3"><b>Location</b><br/>@e.GetProperty("location").GetString()</div><div class="col-md-3"><b>Distance</b><br/>@e.GetProperty("distance").ToString() km</div><div class="col-md-3"><b>Route</b><br/>@e.GetProperty("route").GetProperty("startLocation").GetString() → @e.GetProperty("route").GetProperty("endLocation").GetString()</div></div><h4>Available categories</h4><div class="row">@foreach(var c in e.GetProperty("categories").EnumerateArray()){<div class="col-md-4"><div class="border rounded p-3 mb-2"><b>@c.GetProperty("categoryName").GetString()</b><div class="small text-secondary">Age @c.GetProperty("minAge").GetInt32()–@c.GetProperty("maxAge").GetInt32()</div>@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enrol" method="post" class="mt-2"><input type="hidden" name="EventID" value="@id"/><input type="hidden" name="CategoryID" value="@c.GetProperty("categoryID").GetInt32()"/><button class="btn btn-warning btn-sm">Enter event</button></form>}</div></div>}</div>@if(Context.Session.GetString("Role") is null){<p><a asp-controller="Account" asp-action="Login">Sign in</a> as a Participant to enter this event.</p>}</div></div>
