@model ApiPageViewModel
@{ViewData["Title"]="Discover events";}
<section class="hero mb-4"><span class="text-uppercase small fw-bold">South Africa's event community</span><h1 class="display-5 fw-bold mt-2">Your next finish line<br/>starts here.</h1><p class="lead">Discover running, walking and cycling events. Find your challenge and make race day count.</p><a class="btn btn-warning btn-lg" href="#events">Explore events</a></section>
<div class="d-flex justify-content-between align-items-end mb-3"><div><h2 class="section-title" id="events">Upcoming events</h2><p class="text-secondary mb-0">Find an event and secure your place.</p></div></div>
<div class="row g-2 mb-3"><div class="col-md-6"><input id="eventSearch" class="form-control" placeholder="Search events or locations..."/></div><div class="col-md-3"><select id="eventTypeFilter" class="form-select"><option value="">All event types</option><option>Run</option><option>Walk</option><option>Cycle</option></select></div></div><div class="row g-4" id="eventGrid">@if(Model.Data.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var e in Model.Data.EnumerateArray().Where(x=>x.GetProperty("eventDate").GetDateTime().Date>=DateTime.Today)){var id=e.GetProperty("eventID").GetInt32();var name=e.GetProperty("eventName").GetString();var date=e.GetProperty("eventDate").GetDateTime();var location=e.GetProperty("location").GetString();var type=e.GetProperty("eventType").GetString();var distance=e.GetProperty("distance").ToString();var banner=e.TryGetProperty("bannerImageUrl",out var b)?b.GetString():null;<div class="col-md-6 col-lg-4 event-item" data-search="@($"{name} {location}".ToLowerInvariant())" data-type="@type"><div class="card event-card">@if(!string.IsNullOrWhiteSpace(banner)){<img src="@banner" class="card-img-top" alt="Event banner"/>}else{<div class="event-placeholder">🏃</div>}<div class="card-body"><span class="badge text-bg-primary">@type</span><h5 class="mt-2 fw-bold">@name</h5><p class="text-secondary mb-2">📍 @location</p><p class="mb-3">📅 @date.ToString("dd MMM yyyy") · @distance km</p><a class="btn btn-outline-primary" asp-controller="Events" asp-action="Details" asp-route-id="@id">View event</a></div></div></div>}}else{<p>No events are available at the moment.</p>}</div>

@section Scripts {<script>const search=document.getElementById('eventSearch');const type=document.getElementById('eventTypeFilter');function filterEvents(){const q=(search.value||'').toLowerCase();const t=type.value.toLowerCase();document.querySelectorAll('.event-item').forEach(card=>{card.hidden=!(card.dataset.search.includes(q)&&(!t||card.dataset.type.toLowerCase()===t));});}search.addEventListener('input',filterEvents);type.addEventListener('change',filterEvents);</script>}
