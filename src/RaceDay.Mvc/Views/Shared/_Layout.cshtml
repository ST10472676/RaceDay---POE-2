<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-raceday"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li>@if(Context.Session.GetString("Role")=="Organiser"){<li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage events</a></li>}@if(Context.Session.GetString("Role")=="Participant"){<li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li>}</ul><div class="d-flex gap-2 align-items-center">@if(Context.Session.GetInt32("UserId") is not null){<a class="btn btn-outline-light btn-sm" asp-controller="Profile" asp-action="Index">@Context.Session.GetString("FullName")</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-warning btn-sm">Sign out</button></form>}else{<a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-warning btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a>}</div></div></div></nav><main class="container py-4"><partial name="_Alerts"/>@RenderBody()</main><footer class="py-4 mt-5 text-center text-secondary border-top">RaceDay · Run. Ride. Walk. Together.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
