@model ApiPageViewModel
@{ViewData["Title"]="My results";}<h1 class="section-title">My race history</h1><div class="card panel p-3 table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Data.EnumerateArray()){<tr><td>@x.GetProperty("eventName").GetString()</td><td>@x.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@x.GetProperty("category").GetString()</td><td>@x.GetProperty("finishTime").ToString()</td><td>@x.GetProperty("finishingPosition").ToString()</td><td>@x.GetProperty("resultStatus").GetString()</td></tr>}</tbody></table></div>
