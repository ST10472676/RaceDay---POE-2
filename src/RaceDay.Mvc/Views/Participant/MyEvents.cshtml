@model ApiPageViewModel
@{ViewData["Title"]="My events";}<h1 class="section-title">My events</h1><div class="card panel p-3 table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Category</th><th>Entry date</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model.Data.EnumerateArray()){<tr><td>@x.GetProperty("eventName").GetString()</td><td>@x.GetProperty("categoryName").GetString()</td><td>@x.GetProperty("enrolmentDate").GetDateTime().ToString("dd MMM yyyy")</td><td><span class="status status-@x.GetProperty("status").GetString()?.ToLowerInvariant()">@x.GetProperty("status").GetString()</span></td><td><form asp-action="CancelEnrolment" method="post"><input type="hidden" name="id" value="@x.GetProperty("enrolmentID").GetInt32()"/><button class="btn btn-sm btn-outline-danger">Cancel</button></form></td></tr>}</tbody></table></div>
