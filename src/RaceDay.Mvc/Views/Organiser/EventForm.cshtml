@model EventFormViewModel
@{ViewData["Title"]=Model.EventID is null?"Create event":"Edit event";}<div class="card panel p-4"><h2 class="section-title">@ViewData["Title"]</h2><form method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="EventID" type="hidden"/><input asp-for="BannerImageUrl" type="hidden"/><div class="mb-3"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control"/></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="Distance" class="form-label"></label><input asp-for="Distance" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-md-4 mb-3"><label asp-for="RouteID" class="form-label">Route ID</label><input asp-for="RouteID" class="form-control"/><small class="text-secondary">Use an existing RouteID from your database.</small></div></div><div class="mb-3"><label asp-for="Banner" class="form-label">Event banner (JPEG, PNG or WebP; max 5 MB)</label><input asp-for="Banner" type="file" accept="image/png,image/jpeg,image/webp" class="form-control"/></div><button class="btn btn-warning">Save event</button> <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a></form></div>
