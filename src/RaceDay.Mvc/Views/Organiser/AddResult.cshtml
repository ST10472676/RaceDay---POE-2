@model ResultFormViewModel
@{ViewData["Title"]="Capture race result";}<div class="card panel p-4"><h2 class="section-title">Capture race result</h2><form method="post"><input asp-for="EnrolmentID" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="FinishTime" class="form-label">Finish time (hh:mm:ss)</label><input asp-for="FinishTime" class="form-control" placeholder="01:25:30"/></div><div class="mb-3"><label asp-for="FinishingPosition" class="form-label"></label><input asp-for="FinishingPosition" class="form-control"/></div><div class="mb-3"><label asp-for="ResultStatus" class="form-label"></label><select asp-for="ResultStatus" class="form-select"><option>Completed</option><option>DNF</option><option>DNS</option></select></div><button class="btn btn-warning">Publish result</button></form></div>
