@model OrganiserDashboardViewModel
@{ViewData["Title"]="Organiser dashboard";}<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="section-title">Organiser dashboard</h1><p class="text-secondary">Your event operations at a glance.</p></div><a class="btn btn-warning" asp-action="CreateEvent">+ Create event</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="card panel p-3"><span class="text-secondary">Events created</span><strong class="display-6">@Model.Events.Count</strong></div></div><div class="col-md-4"><div class="card panel p-3"><span class="text-secondary">Upcoming events</span><strong class="display-6">@Model.Events.Count(x=>x.EventDate.Date>=DateTime.Today)</strong></div></div><div class="col-md-4"><div class="card panel p-3"><span class="text-secondary">Total enrolments</span><strong class="display-6">@Model.Events.Sum(x=>x.EnrolmentCount)</strong></div></div></div><h4 class="section-title">Your events</h4><div class="table-responsive card panel p-3"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Distance</th><th>Enrolments</th><th>Actions</th></tr></thead><tbody>@foreach(var e in Model.Events){<tr><td>@e.EventName</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Location</td><td>@e.Distance km</td><td>@e.EnrolmentCount</td><td><a asp-action="Enrolments" asp-route-eventId="@e.EventID">View</a></td></tr>}</tbody></table></div>