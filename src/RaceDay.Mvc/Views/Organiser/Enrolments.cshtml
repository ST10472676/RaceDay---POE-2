@model ApiPageViewModel
@{ViewData["Title"]=Model.Title;}<h2 class="section-title">@Model.Title</h2><div class="card panel p-3 table-responsive"><table class="table align-middle"><thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Status</th><th>Update</th><th>Result</th></tr></thead><tbody>@foreach(var x in Model.Data.EnumerateArray()){var id=x.GetProperty("enrolmentID").GetInt32();var p=x.GetProperty("participant");<tr><td>@p.GetProperty("firstName").GetString() @p.GetProperty("lastName").GetString()</td><td>@p.GetProperty("email").GetString()</td><td>@x.GetProperty("categoryName").GetString()</td><td><span class="status status-@x.GetProperty("status").GetString()?.ToLowerInvariant()">@x.GetProperty("status").GetString()</span></td><td><form asp-action="UpdateEnrolmentStatus" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@id"/><input type="hidden" name="eventId" value="@Context.Request.Query["eventId"]"/><select name="status" class="form-select form-select-sm"><option>Pending</option><option>Confirmed</option><option>Cancelled</option></select><button class="btn btn-sm btn-outline-primary">Save</button></form></td><td><a asp-action="AddResult" asp-route-enrolmentId="@id">Capture result</a></td></tr>}</tbody></table></div>
