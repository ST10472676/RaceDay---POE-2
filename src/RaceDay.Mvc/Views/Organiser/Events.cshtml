@model ApiPageViewModel
@{ViewData["Title"]="Manage events";}<div class="d-flex justify-content-between mb-3"><h1 class="section-title">Manage events</h1><a asp-action="CreateEvent" class="btn btn-warning">+ New event</a></div><div class="row g-3">@foreach(var e in Model.Data.EnumerateArray().Where(x=>x.GetProperty("organiserID").GetInt32()==Context.Session.GetInt32("UserId"))){var id=e.GetProperty("eventID").GetInt32();<div class="col-md-6"><div class="card panel p-3"><h5>@e.GetProperty("eventName").GetString()</h5><p class="text-secondary">@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy") · @e.GetProperty("location").GetString()</p><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="EditEvent" asp-route-id="@id">Edit</a><a class="btn btn-sm btn-outline-primary" asp-action="Categories" asp-route-eventId="@id">Categories</a><a class="btn btn-sm btn-outline-primary" asp-action="Enrolments" asp-route-eventId="@id">Enrolments</a><form asp-action="DeleteEvent" method="post"><input type="hidden" name="id" value="@id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this event?')">Delete</button></form></div></div></div>}</div>
