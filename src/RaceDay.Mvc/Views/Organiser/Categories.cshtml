@model ApiPageViewModel
@{ViewData["Title"]=Model.Title;}<div class="d-flex justify-content-between"><h2 class="section-title">@Model.Title</h2><a class="btn btn-warning" asp-action="AddCategory" asp-route-eventId="@Context.Request.Query["eventId"]">Add category</a></div><div class="card panel p-3"><table class="table"><thead><tr><th>Category</th><th>Minimum age</th><th>Maximum age</th></tr></thead><tbody>@foreach(var c in Model.Data.EnumerateArray()){<tr><td>@c.GetProperty("categoryName").GetString()</td><td>@c.GetProperty("minAge").GetInt32()</td><td>@c.GetProperty("maxAge").GetInt32()</td></tr>}</tbody></table></div>
